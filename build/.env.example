# Адрес Directus: локально — порт из game-directus/.env, на проде — домен CMS
DIRECTUS_URL=http://localhost:8057
# Статик-токен пользователя build@example.com (роль Build, только чтение). Не коммитить.
DIRECTUS_TOKEN=
# Ключ лендинга в коллекции sites
SITE_KEY=dh
# Команда выкладки после сборки. Пусто — только генерация файлов.
DEPLOY_CMD=
